# Smart Visions Chatwoot Candidate template
# Copy outside Git to .env.candidate and resolve every __...__ value from the host secret/config store.

SMARTVISIONS_CHATWOOT_ENV=candidate
CHATWOOT_IMAGE=ghcr.io/hamed665/smartvisions-chatwoot:v4.18.0-sv-6d86ad068c941be8ecf73c22d14205f9254ada41@sha256:942f4e4404dac52c83a938ca5f984186d47c4fecf85f65a6064c2db0a3a92e1e

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
DISABLE_ENTERPRISE=true

FRONTEND_URL=https://candidate-inbox.example.invalid
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false

SECRET_KEY_BASE=__SECRET_STORE__
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=__SECRET_STORE_PRIMARY__
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=__SECRET_STORE_DETERMINISTIC__
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=__SECRET_STORE_DERIVATION_SALT__

POSTGRES_HOST=__CHATWOOT_CANDIDATE_POSTGRES_HOST__
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=__SECRET_STORE__
RAILS_MAX_THREADS=5

REDIS_URL=rediss://__CHATWOOT_CANDIDATE_REDIS_HOST__:6379
REDIS_PASSWORD=__SECRET_STORE__

ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_BUCKET_NAME=__CHATWOOT_CANDIDATE_BUCKET__
STORAGE_ACCESS_KEY_ID=__SECRET_STORE__
STORAGE_SECRET_ACCESS_KEY=__SECRET_STORE__
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://__S3_COMPATIBLE_ENDPOINT__
STORAGE_FORCE_PATH_STYLE=false

RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Candidate intentionally has no native provider credentials.
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# Must remain blank until controlled Smart Core API-Inbox activation.
CHATWOOT_WEBHOOK_PUBLIC_ORIGIN=

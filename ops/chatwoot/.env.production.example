# Smart Visions Chatwoot Production template
# NO REAL SECRETS BELONG IN THIS FILE.

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Defense in depth: Smart Visions source images also remove enterprise/ before build.
DISABLE_ENTERPRISE=true

FRONTEND_URL=https://inbox.smartvisionsai.com
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false

# Generate/store only in the deployment secret store.
SECRET_KEY_BASE=__SECRET_STORE__

# Required for Chatwoot MFA/2FA encryption. Generate separately and keep in the secret store.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=__SECRET_STORE__
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=__SECRET_STORE__
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=__SECRET_STORE__

# Dedicated Chatwoot PostgreSQL. Do not use the Smart Core Supabase schema.
POSTGRES_HOST=__CHATWOOT_POSTGRES_HOST__
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=__SECRET_STORE__
RAILS_MAX_THREADS=5

# Dedicated Chatwoot Redis.
REDIS_URL=rediss://__CHATWOOT_REDIS_HOST__:6379
REDIS_PASSWORD=__SECRET_STORE__

# Durable S3-compatible attachment storage.
# Cloudflare R2 can satisfy this S3-compatible boundary when provisioned.
ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_BUCKET_NAME=__CHATWOOT_STORAGE_BUCKET__
STORAGE_ACCESS_KEY_ID=__SECRET_STORE__
STORAGE_SECRET_ACCESS_KEY=__SECRET_STORE__
STORAGE_REGION=auto
STORAGE_ENDPOINT=__S3_COMPATIBLE_ENDPOINT__
STORAGE_FORCE_PATH_STYLE=false

RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Optional installation email. Configure only when the real SMTP provider is chosen.
MAILER_SENDER_EMAIL=Smart Visions <__VERIFIED_SENDER__>
SMTP_DOMAIN=smartvisionsai.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# Smart Visions intentionally does not place Meta/WhatsApp/Email provider secrets here
# for the initial API-Inbox bridge.

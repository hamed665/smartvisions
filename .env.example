NEXT_PUBLIC_APP_NAME=Smart Visions Growth OS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Preferred modern server-side key. Keep it server-only.
SUPABASE_SECRET_KEY=
# Legacy fallback only if the project still uses a service-role JWT.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
GOOGLE_PLACES_API_KEY=
# Preferred Meta Cloud API token name. META_WHATSAPP_TOKEN remains supported as a legacy alias.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Optional override. The Growth OS defaults to the production Smart Visions Services catalog ID.
META_WHATSAPP_CATALOG_ID=
WHATSAPP_CATALOG_ID=
# Optional. Defaults to v23.0 when omitted.
META_GRAPH_VERSION=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
# Provider webhook signing secret. For Resend this is the whsec_ value from the webhook configuration.
EMAIL_WEBHOOK_SECRET=
REDIS_URL=
CRAWL4AI_URL=
INTERNAL_API_KEY=
# Bootstrap fallback only. Runtime source of truth is public.system_controls.
GLOBAL_KILL_SWITCH=false
SHADOW_MODE=true
